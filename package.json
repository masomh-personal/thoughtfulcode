{
    "name": "hamadeh-io",
    "version": "3.3.0",
    "private": true,
    "scripts": {
        "preinstall": "bun scripts/ensure-bun.ts",
        "dev": "sh scripts/check-toolchain.sh && bun --bun next dev",
        "dev:fresh": "bun run clean:next && bun run dev",
        "build": "sh scripts/check-toolchain.sh && bun --bun next build",
        "start": "bun --bun next start",
        "typegen": "bun --bun next typegen",
        "check": "oxlint --react-plugin --jsx-a11y-plugin --nextjs-plugin .",
        "check:fix": "oxlint --fix --react-plugin --jsx-a11y-plugin --nextjs-plugin . && oxfmt --write .",
        "check:staged": "bun scripts/check-staged.ts",
        "check:toolchain": "sh scripts/check-toolchain.sh",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "type-check": "bun ./node_modules/@typescript/native/bin/tsc --noEmit",
        "type-check:tests": "bun ./node_modules/@typescript/native/bin/tsc --noEmit -p tsconfig.tests.json",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "content:check": "bun scripts/check-content.ts",
        "clean": "bun scripts/clean.ts",
        "clean:next": "bun scripts/clean-next.ts",
        "healthcheck": "sh scripts/check-toolchain.sh && bun run format:check && bun run type-check && bun run type-check:tests && bun run check && bun run content:check && bun run test",
        "new:problem": "bun scripts/new-problem.ts",
        "publish:problem": "bun scripts/publish-problem.ts",
        "prepare": "husky"
    },
    "dependencies": {
        "@11ty/gray-matter": "^2.1.0",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-tabs": "^1.1.21",
        "@tailwindcss/typography": "^0.5.20",
        "clsx": "^2.1.1",
        "highlight.js": "^11.11.1",
        "next": "^16.2.12",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-icons": "^5.7.0",
        "react-markdown": "^10.1.0",
        "rehype-highlight": "^7.0.2",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.6.0",
        "valibot": "^1.4.2"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "@types/bun": "^1.3.14",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript/native": "npm:typescript@^7.0.2",
        "husky": "^9.1.7",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "postcss": "^8.5.19",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "postcss": "^8.5.23",
        "sharp": "^0.35.3"
    },
    "engines": {
        "bun": ">=1.3.14 <2.0.0"
    },
    "packageManager": "bun@1.3.14"
}
